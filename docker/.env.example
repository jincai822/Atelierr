# Atelierr Docker 环境变量（复制为 docker/.env 后修改）

# 镜像拉取注记：若本机 docker daemon 配置了带白名单的 registry mirror 导致
# dullage/flatnotes 被拒（this image is not in the allowlist），可经公共
# mirror 拉取后本地重打标，compose 会优先使用本地镜像（pull policy: missing）：
#   docker pull docker.1ms.run/dullage/flatnotes:latest
#   docker tag docker.1ms.run/dullage/flatnotes:latest dullage/flatnotes:latest

# Flatnotes Web 端口
FLATNOTES_PORT=8080

# 认证（必填）
FLATNOTES_AUTH_TYPE=password
FLATNOTES_USERNAME=admin
FLATNOTES_PASSWORD=change-me
FLATNOTES_SECRET_KEY=change-this-to-a-random-string

# 记忆模块数据目录（$OV/memory 的绝对路径；留空则用 ./data）
MEMORY_DATA_DIR=

# 容器文件属主（与宿主机用户一致，避免权限问题）
PUID=1000
PGID=1000

# $OV 数据树根（Syncthing 容器挂载点；应为 MEMORY_DATA_DIR 的父目录）
OV_DATA_DIR=
