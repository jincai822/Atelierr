# Atelierr Docker 环境变量（复制为 docker/.env 后修改）

# Flatnotes Web 端口
FLATNOTES_PORT=8080

# 认证（必填）
FLATNOTES_AUTH_TYPE=password
FLATNOTES_USERNAME=admin
FLATNOTES_PASSWORD=change-me
FLATNOTES_SECRET_KEY=change-this-to-a-random-string

# 记忆模块数据目录（$OV/memory 的绝对路径；留空则用 ./data）
MEMORY_DATA_DIR=

# 容器文件属主（与宿主机用户一致，避免权限问题）
PUID=1000
PGID=1000
