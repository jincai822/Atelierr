# Atelierr 文档健康月检定时器（与 atelierr-dochealth.service 配套）
#
# 用户级安装:
#   systemctl --user enable --now atelierr-dochealth.timer
# 查看下次触发时间:
#   systemctl --user list-timers atelierr-dochealth.timer
#
# OnCalendar=*-*-02 04:17: 每月 2 日 04:17（错开每日 03:00 的 decay）；
# Persistent=true: 错过的触发（关机/睡眠）在下次启动后立即补跑

[Unit]
Description=Atelierr doc health check timer (monthly)

[Timer]
OnCalendar=*-*-02 04:17
Persistent=true

[Install]
WantedBy=timers.target
