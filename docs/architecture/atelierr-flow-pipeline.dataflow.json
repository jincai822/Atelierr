      "stage": 3,
      "row": 2
    },
    {
      "id": "checklist",
      "type": "database",
      "label": "划重点清单",
      "sublabel": "- [ ] 复选框 + 推荐页码 · 不打扰（无待确认标签）",
      "stage": 3,
      "row": 4
    },
    {
      "id": "you",
