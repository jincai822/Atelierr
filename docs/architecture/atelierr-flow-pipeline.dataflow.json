  "cards": [
    {
      "dot": "cyan",
      "title": "① 捕获：两条入口进同一处",
      "items": [
        "手机：QuickAdd 速记（模板自动带 frontmatter）；正文贴链接；拍照/录音进 attachments/",
        "电脑：Obsidian 直接写笔记；或往 attachments/ 拖截图/录音/PDF；Flatnotes 网页兜底",
        "Syncthing 实时双向同步整个库；state/sessions/exports 不上手机"
      ]
    },
    {
      "dot": "emerald",
      "title": "② 分发：15 分钟一轮，问内容不问设备",
      "items": [
        "links：先 process_pending() 登记新裸笔记，再扫全部笔记正文抓抖音/小红书/B 站 URL",
        "media：扫 attachments/ 新文件（mtime 超 30 秒才动，防读到写入中的文件）",
        "幂等：processed_links/media.json 记状态，同一 URL/文件只成功处理一次；失败 3 次熔断"
      ]
    },
    {
      "dot": "violet",
      "title": "③ 引擎：每条路的逐步动作",
      "items": [
        "链接路：yt-dlp 下载 → Whisper GPU 全文转写 → DeepSeek 整理（标点/分段/观点/标题）",
        "附件路：截图→PaddleOCR；录音→Whisper；产出笔记内嵌 ![[attachments/原文件]]",
        "PDF 路：fitz 逐页提取 → 6000 字分块 → DeepSeek 挑 ≤20 条 → 带推荐页码的复选框清单"
      ]
    },
    {
      "dot": "blue",
      "title": "④ 入库：笔记从此归你",
      "items": [
        "文件名=平台-净化标题（非法字符转 -、截 60 字；撞名加内容 id 短码）",
        "frontmatter 自动带 id/created/source/tags=[待确认]；sidecar 登记 confidence 1.0",
        "铁律：笔记文件创建后机器绝不改写、移动、删除（红线见右卡）"
      ]
    },
    {
      "dot": "amber",
      "title": "⑤ 你只做两件事",
      "items": [
        "摘标签：读完转写/识别稿，手动摘掉「待确认」= 确认入库",
        "勾清单：划重点清单里勾 [x]，15 分钟内自动转正式笔记（带待确认再走一遍①）",
        "不确认不勾也行：会进晨报反复提醒，不会静默消失"
      ]
    }
  ]
