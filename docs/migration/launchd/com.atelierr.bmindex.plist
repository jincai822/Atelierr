<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atelierr.bmindex</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>uvx basic-memory reindex</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ATELIERR_CONFIG</key><string>__REPO__/config/memory.yaml</string>
        <key>HTTPS_PROXY</key><string>http://127.0.0.1:7897</string>
        <key>HTTP_PROXY</key><string>http://127.0.0.1:7897</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>StandardOutPath</key>
    <string>__HOME__/atelierr-data/state/logs/launchd-bmindex.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/atelierr-data/state/logs/launchd-bmindex.log</string>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>20</integer></dict>
</dict>
</plist>
