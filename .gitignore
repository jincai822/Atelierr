# OS
.DS_Store

# Org-specific config (contains private domain names)
scripts/readwise_skip_domains.txt
scripts/atelier/readwise_skip_domains.txt

# Private eval data (filenames-from-$OV as literal test fixtures)
scripts/_evalset.json
scripts/_evalset_v1.json
scripts/_*.json
scripts/_results_*/
scripts/_results_*.log
scripts/_results_*.summary
scripts/_eval_sweep.sh
scripts/atelier/_evalset.json
scripts/atelier/_evalset_v1.json
scripts/atelier/_*.json
scripts/atelier/_results_*/
scripts/atelier/_results_*.log
scripts/atelier/_results_*.summary
scripts/atelier/_eval_sweep.sh

# Atelierr local config (copy from *.example; may contain local paths/credentials)
config/*.yaml
!config/*.yaml.example
docker/.env
docker/data/
docker/syncthing-config/
logs/

# Personal data (PRIVATE — never commit)
# Raw note snapshots
reflect-*/
# Profile with personal identity/goals/expertise
profile
# Personal reference material (examples, sensitive context, reader persona)
personal
# Paper review methodology (functional locally, kept out of public repo)
.claude/commands/paper-review.md
# Signal sweep (private symlink)
.claude/commands/signal-sweep.md
# Handoff plans with personal note references
handoffs
# Local MCP server URL
.mcp.json
# Per-machine permission grants with personal absolute paths (also covered by
# the author's global git ignore, but the repo must not depend on that)
.claude/settings.local.json
# Codex session state
.context/

# Build state
*.build-state.json

# Python virtual environment (typically a symlink to ~/.cache/atelier/.venv
# on the contributor's machine; never committed)
.venv
.venv-atelierr
__pycache__/
*.pyc

# Device-dependent config (each machine gets its own)
semantic.toml

# Per-user path registry overrides (localized wikis, sandbox vaults, etc.)
# Canonical names ship in harness/paths.toml; user overrides go here.
# Loaded by scripts/atelier/_paths.py.
harness/paths.local.toml
harness/intents.local.toml

# Per-user runtime preference. The committed default lives in
# harness/runtimes.toml; this file can select Claude or Codex locally.
harness/runtime.local.toml
harness/.runtime.local.*.tmp

# Per-machine identity for single-owner local routine scheduling.
harness/routine_owner.local.toml
harness/.routine_owner.local.toml.*

# Per-user environment overrides for headless launchd invocations (export OV=..., etc.).
# Sourced by scripts/atelier/launchd/com.atelier.autoevo-nightly.plist. Contains the user's
# absolute vault path; should never be committed.
harness/env.local.sh

# Repo-side local fetch scratch (conference scrapes, throwaway HTML pulls,
# work-in-progress fetches the user has not promoted to the vault). Distinct
# from the vault L1 tier `<paths.cache>/` which resolves under $OV/ and is
# the canonical home for Readwise snapshots and review reports.
cache/
.cache/

# Last-resort containment for accidental repo-relative scratch. Agents must
# use mktemp for disposable artifacts and $OV/cache for reusable derivatives.
/tmp/

# One-off / migration scripts that hardcode private vault content
# (TOPIC_MAPs, lab lists, wiki entry titles). The steady-state generic
# tools live at scripts/atelier/fission.py and scripts/atelier/relink.py.
scripts/oneoff/
scripts/atelier/oneoff/

# Local-first data layer (symlink or subdir; never commit the vault)
zk

# Scheduled-tasks runtime lock (created by /loop and similar)
.claude/scheduled_tasks.lock

# Coverage / pytest artifacts (generated by the Atelierr MVP test runs)
.coverage
htmlcov/
.pytest_cache/

# Atelierr MVP3 输入处理测试夹具（tools/generate_test_data.py 生成，不入库）
tests/fixtures/test_image.jpg
tests/fixtures/test_image.png
tests/fixtures/test_image.webp
tests/fixtures/test_image2.jpg
tests/fixtures/test_image2.png
tests/fixtures/test_image2.webp
tests/fixtures/test.pdf
tests/fixtures/test_scanned.pdf
tests/fixtures/test_with_images.pdf
tests/fixtures/test_audio.wav
tests/fixtures/test_video.mp4
