{
  "permissions": {
    "allow": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run scripts/cues.py --hook",
            "statusMessage": "Loading session cues",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run scripts/cues.py --touch-lock 2>/dev/null || true",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "uv run scripts/atelier.py intent-hook --runtime claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/peer_review_gate.py",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run scripts/shadow.py gc 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
