# 记忆模块配置（复制为 config/memory.yaml 后修改）
# 语义契约见 docs/ACCEPTANCE-CRITERIA.md 与 docs/prd/ARCHITECTURE-LOCKED-V1.md (v1.2)

memory:
  # 平面笔记目录（即 $OV/memory；Flatnotes 直接挂载此目录；递归扫描全部
  # *.md，wiki/、templates/、attachments/、trash/、系统/ 与隐藏目录、
  # Syncthing 冲突副本除外——系统/ 是摘要/控制台等机器产物区）
  root: ~/atelierr-data/memory
  # 中转站目录（机器产出卡的落点；2026-09-13 v1.5 拆分：memory/ 只存
  # 真记忆，待确认卡确认归档后才移进 memory/ 平台目录）；缺省 root 平级
  # inbox/。源文件区在数据根平级 attachments/（不再位于 memory/ 内）
  inbox_dir: ~/atelierr-data/inbox

  # 机器状态目录（sidecar 索引 index.json、衰减报告 reports/、回收站 trash/）
  # 与笔记目录分离：笔记文件创建后机器绝不改写
  state_dir: ~/atelierr-data/state

  # 逻辑分层阈值（layer 存于 sidecar 索引，不是物理目录）
  layers:
    short_term_min: 0.7   # confidence ≥ 0.7        → short-term
    mid_term_min: 0.4     # 0.4 ≤ confidence < 0.7  → mid-term
                          # confidence < 0.4        → long-term

  # 无状态 confidence: conf = decay_rate ** (idle_days × source_factor / ref_factor)
  # idle_days = 距 max(最后访问, 最后修改) 的天数
  # ref_factor = 1 + ref_coefficient * min(references, ref_cap)
  # source_factor = 来源因子（v1.4 方案 C）：link/media = machine_factor，其余 1.0
  decay:
    rate: 0.95            # 无引用笔记约 7 天出 short-term，45 天触及待删区
    ref_coefficient: 0.2  # 引用减缓时间流逝（乘性）
    ref_cap: 10           # 引用因子封顶（factor 最大 3.0）
    delete_threshold: 0.1 # 低于此值置 pending_delete 标记；
                          # 只有 memory_cli review→purge 才移入 trash/
    machine_factor: 3.0   # 方案 C：link/media 转写时间轴倍率（约 15 天触及
                          # 待删）；webclip/highlights 与人写笔记不受此参数影响

  # 复习队列「回响」（decay 的反面）：晨间摘要把快被遗忘的笔记送回面前
  resurface:
    window_low: 0.15      # 低于此值交给 decay 的待删除通道
    window_high: 0.5      # 高于此值说明还"热"，不必推送（约闲置 < 2 周）
    daily_count: 3        # 每天晨报最多推几条
    cooldown_days: 3      # 同一笔记几天内不重复推送

  # 沉淀层 wiki：库根下的子目录名（人工提炼进入；机器只增不改，
  # 无 decay/purge；wiki/ 在 NOTE_EXCLUDED_DIRS 内，与笔记扫描互不干扰）
  wiki_dirname: wiki
