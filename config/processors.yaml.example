# 输入处理器配置（复制为 config/processors.yaml 后修改）

processors:
  image:
    engine: paddleocr     # paddleocr（默认）/ rapidocr（onnxruntime，已实现：
                          # 安装体积小一个数量级、无需 paddlepaddle；整页扫描
                          # CPU 实测 ~0.8s/页 vs paddle 12-14s，扫描件多时用 rapidocr）
    lang: ch              # ch / en
    use_gpu: false
    timeout_s: 5          # 软目标：截图类 < 5s；paddle 整页扫描图 CPU 实测 12-14s
                          # （对齐 docs/ACCEPTANCE-CRITERIA.md 性能表），实现不做硬中断
    # 实现注记：paddlepaddle 3.3.1 + paddleocr 3.x 的 MKLDNN 推理路径会崩溃
    # （NotImplementedError: ConvertPirAttribute2RuntimeAttribute），
    # image.py 构造 PaddleOCR 时固定 enable_mkldnn=False，勿改

  pdf:
    engine: pymupdf
    ocr_images: true      # 提取 PDF 内嵌图片并 OCR
    generate_toc: true    # 生成目录

  video:
    engine: whisper
    model: base           # tiny / base / small / medium / large
    extract_keyframes: true
    # initial_prompt: 引导 Whisper 输出标点的提示语（中文转写不带提示常整段
    # 无标点，2026-09-01 实测）；默认内置带书名号《》的规范中文样例，
    # 英文材料多时可改为英文样例，置空串则不传提示
    # initial_prompt: "以下是普通话转写，使用规范书面标点。"

  audio:
    engine: whisper
    model: base
    # initial_prompt: 同 video 节说明

  link:                 # 链接抓取（抖音已验证 2026-08-31；小红书待真实样本）
    model: large-v3     # 链接视频转写 whisper 模型：人工确认场景求准不求快；
                        # large-v3 实测直接输出简体且专有名词明显更准（对比 medium）
    cookies_browser: chrome  # yt-dlp 借该浏览器 cookie 过抖音反爬
    chrome_profile_dir: ~/.cache/atelierr/douyin-chrome-profile
                        # cookie 自愈（2026-09-01 实测）：cookie 失效时用无头
                        # Chrome 访问视频页（真浏览器内核可过 JS 挑战），
                        # 把新 cookie 刷进此专用 profile 后自动重试，
                        # 不需要人工打开浏览器；无头刷新也失败才报错
    chrome_binary: ""   # 空=自动探测 google-chrome/chromium
    llm:                # 观点总结/分观点论述（可选；key 缺失或调用失败时
                        # 自动降级为无摘要笔记，不阻塞入库）
      base_url: https://api.deepseek.com   # OpenAI 兼容接口
      model: deepseek-v4-flash
      api_key_env: DEEPSEEK_API_KEY   # key 只从环境变量读取，绝不写进本文件；
                                      # 定时任务经 ~/.config/atelierr/env（权限 600）注入
      max_tokens: 800
      timeout: 60
      max_transcript_chars: 6000      # 成本护栏：转写超过此长度跳过摘要（约 10 分钟视频）

# 自动分发的待办判定（dispatch/todos.py 读此节；key 同样只走环境变量，
# 显式 - [ ] / #todo 通道不经过 LLM；LLM 判定产出带"待确认"标签）
# dispatch:
#   todos:
#     llm:
#       base_url: https://api.deepseek.com
#       model: deepseek-v4-flash
#       api_key_env: DEEPSEEK_API_KEY
#       max_tokens: 800
#       timeout: 60
#   notify:             # ntfy 推送：新增待确认内容时通知（只报数量）
#     ntfy_url: https://ntfy.sh   # 或自托管实例
#     topic: ""           # 主题名即口令：用随机长串，写在 config/processors.yaml
#                         # （已 gitignore），不要写进此 example

  wechat:                 # backlog：导出格式不稳定，不在 MVP/完整版验收范围
    input_format: txt     # 微信导出格式

  batch:
    workers: 4            # 批量处理并行数
