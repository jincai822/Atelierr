# 输入处理器配置（复制为 config/processors.yaml 后修改）

processors:
  image:
    engine: paddleocr     # paddleocr（默认）/ rapidocr（onnxruntime，已实现：
                          # 安装体积小一个数量级、无需 paddlepaddle；整页扫描
                          # CPU 实测 ~0.8s/页 vs paddle 12-14s，扫描件多时用 rapidocr）
    lang: ch              # ch / en
    use_gpu: false
    timeout_s: 5          # 软目标：截图类 < 5s；paddle 整页扫描图 CPU 实测 12-14s
                          # （对齐 docs/ACCEPTANCE-CRITERIA.md 性能表），实现不做硬中断
    # 实现注记：paddlepaddle 3.3.1 + paddleocr 3.x 的 MKLDNN 推理路径会崩溃
    # （NotImplementedError: ConvertPirAttribute2RuntimeAttribute），
    # image.py 构造 PaddleOCR 时固定 enable_mkldnn=False，勿改

  pdf:
    engine: pymupdf
    ocr_images: true      # 提取 PDF 内嵌图片并 OCR
    generate_toc: true    # 生成目录

  video:
    engine: whisper
    model: base           # tiny / base / small / medium / large
    extract_keyframes: true

  audio:
    engine: whisper
    model: base

  link:                 # 链接抓取（抖音已验证 2026-08-31；小红书待真实样本）
    model: large-v3     # 链接视频转写 whisper 模型：人工确认场景求准不求快；
                        # large-v3 实测直接输出简体且专有名词明显更准（对比 medium）
    cookies_browser: chrome  # yt-dlp 借该浏览器 cookie 过抖音反爬；
                             # cookie 过期时在该浏览器打开一次 douyin.com 刷新

  wechat:                 # backlog：导出格式不稳定，不在 MVP/完整版验收范围
    input_format: txt     # 微信导出格式

  batch:
    workers: 4            # 批量处理并行数
