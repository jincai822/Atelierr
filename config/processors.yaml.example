# 输入处理器配置（复制为 config/processors.yaml 后修改）

processors:
  image:
    engine: paddleocr     # 备选: rapidocr（onnxruntime，安装体积小一个数量级，
                          # 无需 paddlepaddle；也是未来整页扫描达成 < 5s 的候选路径）
    lang: ch              # ch / en
    use_gpu: false
    timeout_s: 5          # 软目标：截图类 < 5s；整页扫描图 CPU 实测 12-14s
                          # （对齐 docs/ACCEPTANCE-CRITERIA.md 性能表），实现不做硬中断
    # 实现注记：paddlepaddle 3.3.1 + paddleocr 3.x 的 MKLDNN 推理路径会崩溃
    # （NotImplementedError: ConvertPirAttribute2RuntimeAttribute），
    # image.py 构造 PaddleOCR 时固定 enable_mkldnn=False，勿改

  pdf:
    engine: pymupdf
    ocr_images: true      # 提取 PDF 内嵌图片并 OCR
    generate_toc: true    # 生成目录

  video:
    engine: whisper
    model: base           # tiny / base / small / medium / large
    extract_keyframes: true

  audio:
    engine: whisper
    model: base

  wechat:                 # backlog：导出格式不稳定，不在 MVP/完整版验收范围
    input_format: txt     # 微信导出格式

  batch:
    workers: 4            # 批量处理并行数
