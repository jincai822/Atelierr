{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routine",
    "outcome",
    "output_file",
    "summary",
    "skipped_inputs"
  ],
  "properties": {
    "routine": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "delivered",
        "noop",
        "failed"
      ]
    },
    "output_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "skipped_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
