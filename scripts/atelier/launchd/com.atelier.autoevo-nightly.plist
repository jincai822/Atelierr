<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atelier.autoevo-nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <!-- Delegates to routine_runner.sh which handles:
             - environment setup ($OV, PATH, ATELIER_SKIP_LOCK_TOUCH)
             - hostname-based stagger for multi-machine coordination
             - DynamoDB lock acquire/release (when coordination enabled)
             - local claim file write for cue system
             - fixed headless Codex invocation and status tracking -->
        <string>"$HOME/atelier/scripts/routine_runner.sh" autoevo-nightly /autoevo-nightly</string>
    </array>

    <!-- Missing Hour is a launchd wildcard, so this fires at the top of every
         hour. The runner exits cheaply for completed, fenced, and not-yet-due
         deferred claims. Missed calendar events are coalesced on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Covers login or LaunchAgent reload after a scheduled event was missed.
         The runner maps pre-05:00 catch-up to yesterday and rejects duplicates. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- launchd captures stdout/stderr to user-readable log paths.
         The autoevo-nightly script's audit log lives separately under
         $OV/agent-findings/autoevo-applied-<date>.md; these capture only
         the shell wrapper + Codex stdout/stderr. -->
    <key>StandardOutPath</key>
    <string>/tmp/com.atelier.autoevo-nightly.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.atelier.autoevo-nightly.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
